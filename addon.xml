<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.logviewer" name="Log Viewer for Kodi" provider-name="i96751414" version="3.0.0+matrix.1">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.python.module" library="resources/lib/"/>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <source>https://github.com/i96751414/script.logviewer</source>
        <summary lang="en_GB">Stream command output directly on Kodi</summary>
        <description lang="en_GB">Run any shell command and stream its output in a full-screen text window with live updates. Useful for tailing logs, docker container output, etc.</description>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
